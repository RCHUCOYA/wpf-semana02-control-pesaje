<Window x:Class="WPF_SEMANA02.Views.ReporteIngresosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de Ingresos"
        Height="540"
        Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Reporte de ingresos" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Operaciones registradas temporalmente durante la sesión." Foreground="#64748B" Margin="0,5,0,0" />
        </StackPanel>

        <DataGrid x:Name="dgIngresos" Grid.Row="1" Margin="0,18,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" />
                <DataGridTextColumn Header="Documento" Binding="{Binding NumeroDocumento}" />
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" />
                <DataGridTextColumn Header="Peso" Binding="{Binding Peso}" />
                <DataGridTextColumn Header="Vehículo" Binding="{Binding TipoVehiculo}" />
                <DataGridTextColumn Header="Transportista" Binding="{Binding Transportista}" />
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" />
                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion}" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" HorizontalAlignment="Left" Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click" />
    </Grid>
</Window>
