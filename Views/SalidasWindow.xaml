<Window x:Class="WPF_SEMANA02.Views.SalidasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Salidas"
        Height="700"
        Width="860"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Background="#1E293B" Padding="30,20">
            <StackPanel>
                <TextBlock Text="Registro de Salidas" Foreground="White" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Complete los datos del vehículo y presione Guardar." Foreground="#CBD5E1" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border Background="White" CornerRadius="10" Padding="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Tipo de documento" FontWeight="SemiBold" />
                            <ComboBox x:Name="cmbTipoDocumento">
                                <ComboBoxItem Content="DNI" />
                                <ComboBoxItem Content="RUC" />
                                <ComboBoxItem Content="CE" />
                                <ComboBoxItem Content="Otro" />
                            </ComboBox>

                            <TextBlock Text="Número de documento" FontWeight="SemiBold" />
                            <TextBox x:Name="txtNumeroDocumento" />

                            <TextBlock Text="Peso" FontWeight="SemiBold" />
                            <TextBox x:Name="txtPeso" />

                            <TextBlock Text="Tipo de vehículo" FontWeight="SemiBold" />
                            <ComboBox x:Name="cmbTipoAuto">
                                <ComboBoxItem Content="Camión" />
                                <ComboBoxItem Content="Tráiler" />
                                <ComboBoxItem Content="Motocicleta" />
                                <ComboBoxItem Content="Automóvil" />
                                <ComboBoxItem Content="Furgón" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nombre del transportista" FontWeight="SemiBold" />
                            <TextBox x:Name="txtTransportista" />

                            <TextBlock Text="Fecha" FontWeight="SemiBold" />
                            <DatePicker x:Name="dpFecha" Margin="0,5,0,14" />

                            <TextBlock Text="Hora (HH:mm)" FontWeight="SemiBold" />
                            <TextBox x:Name="txtHora" />

                            <TextBlock Text="Peso de ingreso" FontWeight="SemiBold" />
                            <TextBox x:Name="txtPesoIngreso" />

                            <TextBlock Text="Peso de salida" FontWeight="SemiBold" />
                            <TextBox x:Name="txtPesoSalida" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,10">
                    <Button Content="Guardar" Style="{StaticResource BotonPrincipal}" Click="Guardar_Click" />
                    <Button Content="Limpiar" Style="{StaticResource BotonSecundario}" Click="Limpiar_Click" />
                    <Button Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click" />
                </StackPanel>

                <DataGrid Grid.Row="2" x:Name="dgSalidas" Margin="0,12,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Documento" Binding="{Binding NumeroDocumento}" Width="*" />
                        <DataGridTextColumn Header="Transportista" Binding="{Binding NombreTransportista}" Width="2*" />
                        <DataGridTextColumn Header="Vehículo" Binding="{Binding TipoAuto}" Width="*" />
                        <DataGridTextColumn Header="Peso" Binding="{Binding Peso}" Width="*" />
                        <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding FechaYHora, StringFormat=dd/MM/yyyy HH:mm}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
