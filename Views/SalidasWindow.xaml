<Window x:Class="WPF_SEMANA02.Views.SalidasWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registro de salidas" Height="680" Width="780" WindowStartupLocation="CenterOwner"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="35"><StackPanel><TextBlock Text="Registro de salidas" FontSize="28" FontWeight="Bold"/><TextBlock Text="La información quedará disponible en el reporte de salidas durante esta sesión." Foreground="#64748B" Margin="0,5,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="25"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tipo de documento" FontWeight="SemiBold"/><ComboBox x:Name="cmbTipoDocumento"><ComboBoxItem Content="DNI"/><ComboBoxItem Content="RUC"/><ComboBoxItem Content="CE"/><ComboBoxItem Content="Otro"/></ComboBox><TextBlock Text="Número documento" FontWeight="SemiBold"/><TextBox x:Name="txtNumeroDocumento"/><TextBlock Text="Peso" FontWeight="SemiBold"/><TextBox x:Name="txtPeso"/><TextBlock Text="Tipo de auto" FontWeight="SemiBold"/><ComboBox x:Name="cmbTipoAuto"><ComboBoxItem Content="Camión"/><ComboBoxItem Content="Tráiler"/><ComboBoxItem Content="Motocicleta"/><ComboBoxItem Content="Automóvil"/><ComboBoxItem Content="Furgón"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Nombre transportista" FontWeight="SemiBold"/><TextBox x:Name="txtTransportista"/><TextBlock Text="Fecha" FontWeight="SemiBold"/><DatePicker x:Name="dpFecha" Margin="0,4,0,12"/><TextBlock Text="Hora (HH:mm)" FontWeight="SemiBold"/><TextBox x:Name="txtHora"/><TextBlock Text="Peso de ingreso" FontWeight="SemiBold"/><TextBox x:Name="txtPesoIngreso"/><TextBlock Text="Peso de salida" FontWeight="SemiBold"/><TextBox x:Name="txtPesoSalida"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Guardar" Style="{StaticResource BotonPrincipal}" Click="Guardar_Click"/><Button Content="Limpiar" Style="{StaticResource BotonSecundario}" Click="Limpiar_Click"/><Button Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click"/></StackPanel></StackPanel></Grid></ScrollViewer></Window>
