<Window x:Class="WPF_SEMANA02.Views.IngresosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Ingresos"
        Height="700"
        Width="780"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="35">
            <StackPanel>
                <TextBlock Text="Registro de ingresos" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Registre los datos iniciales del vehículo y su carga." Foreground="#64748B" Margin="0,5,0,20" />

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Tipo de documento" FontWeight="SemiBold" />
                            <ComboBox x:Name="cmbTipoDocumento">
                                <ComboBoxItem Content="DNI" />
                                <ComboBoxItem Content="RUC" />
                                <ComboBoxItem Content="CE" />
                                <ComboBoxItem Content="Otro" />
                            </ComboBox>

                            <TextBlock Text="Número de documento" FontWeight="SemiBold" />
                            <TextBox x:Name="txtNumeroDocumento" />

                            <TextBlock Text="Placa del vehículo" FontWeight="SemiBold" />
                            <TextBox x:Name="txtPlaca" />

                            <TextBlock Text="Tipo de vehículo" FontWeight="SemiBold" />
                            <ComboBox x:Name="cmbTipo">
                                <ComboBoxItem Content="Camión" />
                                <ComboBoxItem Content="Tráiler" />
                                <ComboBoxItem Content="Motocicleta" />
                                <ComboBoxItem Content="Automóvil" />
                                <ComboBoxItem Content="Furgón" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fecha" FontWeight="SemiBold" />
                            <DatePicker x:Name="dpFecha" Margin="0,5,0,14" />

                            <TextBlock Text="Peso de ingreso" FontWeight="SemiBold" />
                            <TextBox x:Name="txtPeso" />

                            <TextBlock Text="Nombre del transportista" FontWeight="SemiBold" />
                            <TextBox x:Name="txtTransportista" />

                            <TextBlock Text="Producto o carga" FontWeight="SemiBold" />
                            <TextBox x:Name="txtProducto" />

                            <TextBlock Text="Observación" FontWeight="SemiBold" />
                            <TextBox x:Name="txtObservacion" Height="45" TextWrapping="Wrap" AcceptsReturn="True" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Guardar" Style="{StaticResource BotonPrincipal}" Click="Guardar_Click" />
                    <Button Content="Limpiar" Style="{StaticResource BotonSecundario}" Click="Limpiar_Click" />
                    <Button Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
