<Window x:Class="WPF_SEMANA02.Views.IngresosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registro de ingresos" Height="520" Width="650" WindowStartupLocation="CenterOwner"><Grid Margin="35"><StackPanel><TextBlock Text="Registro de ingresos" FontSize="28" FontWeight="Bold"/><TextBlock Text="Registre el ingreso de un vehículo." Foreground="#64748B" Margin="0,5,0,20"/><TextBlock Text="Fecha" FontWeight="SemiBold"/><DatePicker x:Name="dpFecha" Margin="0,4,0,12"/><TextBlock Text="Peso" FontWeight="SemiBold"/><TextBox x:Name="txtPeso"/><TextBlock Text="Tipo de vehículo" FontWeight="SemiBold"/><ComboBox x:Name="cmbTipo"><ComboBoxItem Content="Camión"/><ComboBoxItem Content="Tráiler"/><ComboBoxItem Content="Motocicleta"/><ComboBoxItem Content="Automóvil"/><ComboBoxItem Content="Furgón"/></ComboBox><TextBlock Text="Transportista" FontWeight="SemiBold"/><TextBox x:Name="txtTransportista"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Guardar" Style="{StaticResource BotonPrincipal}" Click="Guardar_Click"/><Button Content="Limpiar" Style="{StaticResource BotonSecundario}" Click="Limpiar_Click"/><Button Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click"/></StackPanel></StackPanel></Grid></Window>
