<?xml version="1.0"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WPF_SEMANA02.Views.ReportesWindow" Title="Reportes" Height="470" Width="760" WindowStartupLocation="CenterOwner">
  <Grid Margin="40">
    <StackPanel>
      <TextBlock Text="Reportes" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="Listados b&#xE1;sicos para consultar los datos registrados." Foreground="#64748B" Margin="0,6,0,24"/>
      <UniformGrid Columns="3">
        <Button Content="Cargas" Style="{StaticResource BotonPrincipal}" Click="Cargas_Click"/>
        <Button Content="Ingresos" Style="{StaticResource BotonPrincipal}" Click="Ingresos_Click"/>
        <Button Content="Salidas" Style="{StaticResource BotonPrincipal}" Click="Salidas_Click"/>
      </UniformGrid>
      <Button Content="Volver al men&#xFA;" Style="{StaticResource BotonSecundario}" HorizontalAlignment="Left" Margin="0,26,0,0" Click="Volver_Click"/>
    </StackPanel>
  </Grid>
</Window>
