<?xml version="1.0"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WPF_SEMANA02.Views.OperacionesWindow" Title="Operaciones" Height="420" Width="600" WindowStartupLocation="CenterOwner">
  <Grid Margin="40">
    <StackPanel>
      <TextBlock Text="Operaciones" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="En este m&#xF3;dulo se registran las operaciones del sistema." Foreground="#64748B" Margin="0,6,0,28"/>
      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="24">
        <StackPanel>
          <TextBlock Text="Ingreso de veh&#xED;culo" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="Plantilla sencilla para registrar fecha, peso, tipo de veh&#xED;culo y transportista." Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,15"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="Ingresos (plantilla)" Style="{StaticResource BotonPrincipal}" Click="Ingresos_Click"/>
            <Button Content="Salidas" Style="{StaticResource BotonPrincipal}" Click="Salidas_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Button Content="Volver al men&#xFA;" Style="{StaticResource BotonSecundario}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="Volver_Click"/>
    </StackPanel>
  </Grid>
</Window>
