<Window x:Class="WPF_SEMANA02.Views.CamionesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mantenimiento de camiones" Height="620" Width="760" WindowStartupLocation="CenterOwner"><Grid Margin="35"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Mantenimiento de camiones" FontSize="28" FontWeight="Bold"/><Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Peso máximo" FontWeight="SemiBold"/><TextBox x:Name="txtPesoMaximo"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Placa" FontWeight="SemiBold"/><TextBox x:Name="txtPlaca"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Peso vacío" FontWeight="SemiBold"/><TextBox x:Name="txtPesoVacio"/></StackPanel></Grid><StackPanel Orientation="Horizontal"><Button Content="Nuevo" Style="{StaticResource BotonSecundario}" Click="Nuevo_Click"/><Button Content="Guardar" Style="{StaticResource BotonPrincipal}" Click="Guardar_Click"/><Button Content="Limpiar" Style="{StaticResource BotonSecundario}" Click="Limpiar_Click"/><Button Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click"/></StackPanel></StackPanel><DataGrid Grid.Row="1" x:Name="dgCamiones"><DataGrid.Columns><DataGridTextColumn Header="Placa" Binding="{Binding Placa}"/><DataGridTextColumn Header="Peso Máximo" Binding="{Binding PesoMaximo}"/><DataGridTextColumn Header="Peso Vacío" Binding="{Binding PesoVacio}"/></DataGrid.Columns></DataGrid></Grid></Window>
