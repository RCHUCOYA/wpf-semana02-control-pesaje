<Window x:Class="WPF_SEMANA02.Views.ReporteSalidasWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reporte de salidas" Height="600" Width="1080" WindowStartupLocation="CenterOwner"><Grid Margin="35"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Reporte de salidas" FontSize="28" FontWeight="Bold"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center"><TextBlock Text="Nombre transportista:" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="txtBuscarTransportista" Width="300" Margin="12,0,4,0"/><Button Content="Buscar" Style="{StaticResource BotonPrincipal}" Click="Buscar_Click"/><Button Content="Limpiar" Style="{StaticResource BotonSecundario}" Click="Limpiar_Click"/></StackPanel><DataGrid x:Name="dgSalidas" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}"/><DataGridTextColumn Header="Peso" Binding="{Binding Peso}"/><DataGridTextColumn Header="Tipo Auto" Binding="{Binding TipoAuto}"/><DataGridTextColumn Header="Transportista" Binding="{Binding NombreTransportista}"/><DataGridTextColumn Header="P. Ing." Binding="{Binding PesoIngreso}"/><DataGridTextColumn Header="P. Sal." Binding="{Binding PesoSalida}"/><DataGridTextColumn Header="Fecha/Hora" Binding="{Binding FechaYHora, StringFormat=dd/MM/yyyy HH:mm}"/></DataGrid.Columns></DataGrid><Button Grid.Row="3" HorizontalAlignment="Left" Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click"/></Grid></Window>
