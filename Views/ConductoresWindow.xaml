<Window x:Class="WPF_SEMANA02.Views.ConductoresWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mantenimiento de conductores" Height="500" Width="700" WindowStartupLocation="CenterOwner"><Grid Margin="35"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Listado de conductores" FontSize="28" FontWeight="Bold"/><TextBlock Text="El enunciado académico solicita las columnas de peso y placa." Foreground="#64748B" Margin="0,5,0,4"/></StackPanel><DataGrid x:Name="dgConductores" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Peso Máximo" Binding="{Binding PesoMaximo}"/><DataGridTextColumn Header="Placa" Binding="{Binding Placa}"/><DataGridTextColumn Header="Peso Vacío" Binding="{Binding PesoVacio}"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" HorizontalAlignment="Left" Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click"/></Grid></Window>
