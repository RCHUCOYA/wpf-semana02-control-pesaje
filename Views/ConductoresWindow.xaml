<?xml version="1.0"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WPF_SEMANA02.Views.ConductoresWindow" Title="Mantenimiento de conductores" Height="500" Width="700" WindowStartupLocation="CenterOwner">
  <Grid Margin="35">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Listado de conductores" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="El enunciado acad&#xE9;mico solicita las columnas de peso y placa." Foreground="#64748B" Margin="0,5,0,4"/>
    </StackPanel>
    <DataGrid x:Name="dgConductores" Grid.Row="1">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Peso M&#xE1;ximo" Binding="{Binding PesoMaximo}"/>
        <DataGridTextColumn Header="Placa" Binding="{Binding Placa}"/>
        <DataGridTextColumn Header="Peso Vac&#xED;o" Binding="{Binding PesoVacio}"/>
      </DataGrid.Columns>
    </DataGrid>
    <Button Grid.Row="2" HorizontalAlignment="Left" Content="Volver" Style="{StaticResource BotonSecundario}" Click="Volver_Click"/>
  </Grid>
</Window>
