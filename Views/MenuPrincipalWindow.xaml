<Window x:Class="WPF_SEMANA02.Views.MenuPrincipalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sistema de Control de Pesaje" Height="720" Width="1150" WindowStartupLocation="CenterScreen">
