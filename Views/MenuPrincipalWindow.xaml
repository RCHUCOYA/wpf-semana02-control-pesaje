<?xml version="1.0"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WPF_SEMANA02.Views.MenuPrincipalWindow" Title="Sistema de Control de Pesaje" Height="600" Width="960" WindowStartupLocation="CenterScreen">
  <Grid>
    <Border Background="#1E293B" Height="82" VerticalAlignment="Top">
      <DockPanel Margin="35,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="SISTEMA DE CONTROL DE PESAJE" Foreground="White" FontSize="21" FontWeight="Bold"/>
          <TextBlock Text="  |  Men&#xFA; principal" Foreground="#CBD5E1" FontSize="15" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Inicio" Style="{StaticResource BotonSecundario}" Click="Inicio_Click"/>
          <Button Content="Cerrar sesi&#xF3;n" Style="{StaticResource BotonSecundario}" Click="CerrarSesion_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Margin="65,130,65,50">
      <TextBlock Text="&#xBF;Qu&#xE9; deseas gestionar?" FontSize="30" FontWeight="Bold" Foreground="#111827"/>
      <TextBlock Text="Selecciona un m&#xF3;dulo para continuar." Foreground="#64748B" FontSize="16" Margin="0,7,0,32"/>
      <UniformGrid Columns="3" HorizontalAlignment="Stretch">
        <Button Style="{StaticResource TarjetaModulo}" Click="Operaciones_Click">
          <StackPanel>
            <TextBlock Text="1" Style="{StaticResource NumeroModulo}"/>
            <TextBlock Text="Operaciones" Style="{StaticResource TituloModulo}"/>
            <TextBlock Text="Registro de ingresos" Style="{StaticResource TextoModulo}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource TarjetaModulo}" Click="Mantenimientos_Click">
          <StackPanel>
            <TextBlock Text="2" Style="{StaticResource NumeroModulo}"/>
            <TextBlock Text="Mantenimientos" Style="{StaticResource TituloModulo}"/>
            <TextBlock Text="Camiones, conductores, transportistas y productos" Style="{StaticResource TextoModulo}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource TarjetaModulo}" Click="Reportes_Click">
          <StackPanel>
            <TextBlock Text="3" Style="{StaticResource NumeroModulo}"/>
            <TextBlock Text="Reportes" Style="{StaticResource TituloModulo}"/>
            <TextBlock Text="Listados de cargas, ingresos y salidas" Style="{StaticResource TextoModulo}"/>
          </StackPanel>
        </Button>
      </UniformGrid>
      <Button Content="Salir del programa" Style="{StaticResource BotonSecundario}" HorizontalAlignment="Left" Margin="0,30,0,0" Click="Salir_Click"/>
    </StackPanel>
  </Grid>
</Window>
