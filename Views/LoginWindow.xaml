<?xml version="1.0"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WPF_SEMANA02.Views.LoginWindow" Title="Sistema de Control de Pesaje" Height="470" Width="760" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="310"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Border Background="#1E293B" Padding="34">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="SISTEMA DE" Foreground="#93C5FD" FontWeight="Bold"/>
        <TextBlock Text="Control de&#10;Pesaje" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,8,0,16"/>
        <TextBlock Text="Gestione ingresos, salidas y operaciones de transporte en un solo lugar." TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="15"/>
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="White" Padding="58">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Bienvenido" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock Text="Ingrese sus credenciales para continuar." Foreground="#64748B" Margin="0,5,0,28"/>
        <TextBlock Text="Usuario" FontWeight="SemiBold"/>
        <TextBox x:Name="txtUsuario"/>
        <TextBlock Text="Contraseña" FontWeight="SemiBold"/>
        <PasswordBox x:Name="txtContrasena" Padding="9" Margin="0,5,0,20"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Ingresar" Style="{StaticResource BotonPrincipal}" Click="Ingresar_Click"/>
          <Button Content="Salir" Style="{StaticResource BotonSecundario}" Click="Salir_Click"/>
        </StackPanel>
        <TextBlock Text="Usuario: admin  ·  Contraseña: 1234" Foreground="#94A3B8" FontSize="12" Margin="4,20,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
