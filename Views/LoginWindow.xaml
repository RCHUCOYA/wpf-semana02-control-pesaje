<Window x:Class="WPF_SEMANA02.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Control de Pesaje"
        Height="430"
        Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Background="#1E293B" Padding="35">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SISTEMA DE" Foreground="#93C5FD" FontWeight="Bold" />
                <TextBlock Text="Control de&#x0a;Pesaje" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,8,0,18" />
                <TextBlock Text="Proyecto académico de registro de salidas." Foreground="#CBD5E1" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" Padding="55">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Bienvenido" FontSize="28" FontWeight="Bold" Foreground="#111827" />
                <TextBlock Text="Presiona Ingresar para abrir el formulario." Foreground="#64748B" Margin="0,6,0,28" />
                <Button Content="Ingresar" Style="{StaticResource BotonPrincipal}" HorizontalAlignment="Left" Click="Ingresar_Click" />
                <Button Content="Salir" Style="{StaticResource BotonSecundario}" HorizontalAlignment="Left" Click="Salir_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
